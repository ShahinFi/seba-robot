[Unit]
Description=SEBA-ROBOT Wi-Fi hotspot fallback
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
Environment=SEBA_WEB_PORT=@WEB_PORT@
ExecStart=/usr/bin/env bash @REPO_DIR@/raspberry-pi/hotspot.sh monitor
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
