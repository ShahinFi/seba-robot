# Local SEBA Raspberry Pi web credentials.
# Create raspberry-pi/local_config.env with:
#   bash raspberry-pi/install.sh auth
#
# Manual hash generation, if needed:
#   PYTHONPATH=raspberry-pi .venv/bin/python3 -m seba_pi.auth_hash

SEBA_OPERATOR_PASSWORD_HASH=pbkdf2_sha256$...
SEBA_ENGINEER_PASSWORD_HASH=pbkdf2_sha256$...
SEBA_SESSION_SECRET=replace-with-random-secret
